{
  "info": {
    "name": "CDY2204 - Exp1 S3 - S3_Grupo3 (Guias de Despacho)",
    "description": "Pruebas de los endpoints del Sistema de Gestion de Guias de Despacho (Spring Boot + EFS + S3). Base: {{baseUrl}}. Flujo sugerido: 1 crear -> 2 subir -> 3 listar -> 4 descargar -> 5 actualizar -> 6 eliminar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://107.23.67.117:8080" },
    { "key": "idGuia", "value": "1001" },
    { "key": "fecha", "value": "2026-06-07" },
    { "key": "transportista", "value": "transportistaX" }
  ],
  "item": [
    {
      "name": "1. POST - Crear guia (EFS)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idGuia\": \"{{idGuia}}\",\n  \"transportista\": \"{{transportista}}\",\n  \"fecha\": \"{{fecha}}\",\n  \"pedido\": \"PED-5001\",\n  \"destino\": \"Santiago\",\n  \"datosAdicionales\": \"Caja fragil\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/guias",
          "host": [ "{{baseUrl}}" ],
          "path": [ "guias" ]
        },
        "description": "Crea la guia y la escribe en el EFS (/app/efs/{fecha}/{transportista}/guia_{id}.pdf). Criterio 1."
      }
    },
    {
      "name": "2. POST - Subir guia a S3",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/guias/{{idGuia}}/upload?fecha={{fecha}}&transportista={{transportista}}",
          "host": [ "{{baseUrl}}" ],
          "path": [ "guias", "{{idGuia}}", "upload" ],
          "query": [
            { "key": "fecha", "value": "{{fecha}}" },
            { "key": "transportista", "value": "{{transportista}}" }
          ]
        },
        "description": "Sube a S3 la guia YA creada en EFS en el paso 1 (la ubica por id/fecha/transportista). Sin body. Criterio 2."
      }
    },
    {
      "name": "3. GET - Consultar / listar guias",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/guias?fecha={{fecha}}&transportista={{transportista}}",
          "host": [ "{{baseUrl}}" ],
          "path": [ "guias" ],
          "query": [
            { "key": "fecha", "value": "{{fecha}}" },
            { "key": "transportista", "value": "{{transportista}}" }
          ]
        },
        "description": "Lista las guias en S3 filtrando por fecha y transportista. Criterio 5. (Puedes quitar los query params para listar todo.)"
      }
    },
    {
      "name": "4. GET - Descargar guia",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/guias/{{idGuia}}/download?fecha={{fecha}}&transportista={{transportista}}",
          "host": [ "{{baseUrl}}" ],
          "path": [ "guias", "{{idGuia}}", "download" ],
          "query": [
            { "key": "fecha", "value": "{{fecha}}" },
            { "key": "transportista", "value": "{{transportista}}" }
          ]
        },
        "description": "Descarga la guia desde S3. Criterio 4. Para guardarla: Send -> Save response -> Save to a file."
      }
    },
    {
      "name": "5. PUT - Actualizar guia",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"transportista\": \"{{transportista}}\",\n  \"fecha\": \"{{fecha}}\",\n  \"pedido\": \"PED-5001\",\n  \"destino\": \"Concepcion\",\n  \"datosAdicionales\": \"Destino corregido\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/guias/{{idGuia}}",
          "host": [ "{{baseUrl}}" ],
          "path": [ "guias", "{{idGuia}}" ]
        },
        "description": "Regenera la guia con un dato modificado y reemplaza el objeto en S3. Criterio 3."
      }
    },
    {
      "name": "6. DELETE - Eliminar guia",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/guias/{{idGuia}}?fecha={{fecha}}&transportista={{transportista}}",
          "host": [ "{{baseUrl}}" ],
          "path": [ "guias", "{{idGuia}}" ],
          "query": [
            { "key": "fecha", "value": "{{fecha}}" },
            { "key": "transportista", "value": "{{transportista}}" }
          ]
        },
        "description": "Elimina la guia del bucket S3."
      }
    }
  ]
}
